<odoo>

    <record id="group_as400_manager" model="res.groups">
        <field name="name">AS400 Integration / Administrator</field>
        <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="rule_as400_config_company" model="ir.rule">
        <field name="name">AS400 Config: multi-company</field>
        <field name="model_id" ref="model_as400_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_as400_api_log_company" model="ir.rule">
        <field name="name">AS400 API Log: multi-company</field>
        <field name="model_id" ref="model_as400_api_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
